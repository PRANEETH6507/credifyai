            { "name": "confidence", "value": "={{ $json.confidence }}" },
            { "name": "reason", "value": "={{ $json.reason }}" }
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1700, -64],
