    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": {{($json.status || \"\") === \"verified\"}},\n  \"verification_status\": \"{{$json.status || 'unknown'}}\",\n  \"confidence\": {{$json.confidence || 0}},\n  \"reason\": \"{{($json.reason || '').replace(/\\\"/g, '\\\\\\\"')}}\",\n  \"message\": \"{{($json.status || \"\") === 'verified' ? 'Certificate Registry Match Confirmed' : 'Verification Denied'}}\"\n}",
        "options": { "responseCode": 200 }
      },
