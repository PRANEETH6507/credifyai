    {
      "parameters": {
        "method": "POST",
        "url": "https://api.ocr.space/parse/image",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "name": "apikey", "value": "YOUR_OCR_SPACE_API_KEY" },
            { "name": "url", "value": "={{ $node[\"Webhook\"].json.body.certificate_url }}" },
            { "name": "language", "value": "eng" },
            { "name": "filetype", "value": "pdf" }
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [912, -64],
      "id": "5172614c-c96b-46c2-ac0b-7561d51eaf10",
      "name": "OCR.space"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const text = $json.ParsedResults?.[0]?.ParsedText || \"\";\n\n// 1. Try exact match first (12 digits)\nlet rollMatch = text.match(/\\d{12}/);\n\n// 2. If no match, strip ALL spaces and try again (common OCR issue)\nif (!rollMatch) {\n  const squashed = text.replace(/\\s/g, \"\");\n  rollMatch = squashed.match(/\\d{12}/);\n}\n\nconst roll_number = rollMatch ? rollMatch[0] : null;\nconst certificate_hash = $items(\"Generate_Certificate_Hash\")[0].json.certificate_hash;\n\nreturn {\n  json: {\n    roll_number,\n    program: \"B.Tech Computer Science and Engineering\",\n    semester: \"1-1\",    \n    certificate_hash,\n    full_raw_text: text\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1104, -64],
      "id": "b7f09be1-4e19-4bbc-9d07-d5b2dd42bbb8",
      "name": "Extract_OCR_Fields"
    },
    {
      "parameters": {
        "url": "https://YOUR_SUPABASE_PROJECT_REF.supabase.co/rest/v1/student_records",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "roll_number", "value": "=eq.{{ $json.roll_number }}" },
            { "name": "semester", "value": "=eq.{{ $json.semester }}" },
            { "name": "certificate_hash", "value": "=eq.{{ $json.certificate_hash }}" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "YOUR_SUPABASE_ANON_KEY" },
            { "name": "Authorization", "value": "Bearer YOUR_SUPABASE_ANON_KEY" }
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1296, -64],
      "id": "9b05dc1c-a35b-49a5-968d-656da5fe810d",
      "name": "Fetch_Student_Record",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ocr = $items(\"Extract_OCR_Fields\")[0].json;\nconst dbRows = $items(\"Fetch_Student_Record\");\n\n// If OCR failed to even find a roll number\nif (!ocr.roll_number) {\n  return {\n    json: {\n      status: \"fake\",\n      confidence: 0,\n      reason: \"OCR FAIL: Could not find a 12-digit Roll Number on the certificate image/PDF.\"\n    }\n  };\n}\n\nif (!dbRows || dbRows.length === 0 || !dbRows[0].json || Object.keys(dbRows[0].json).length === 0) {\n  return {\n    json: {\n      status: \"fake\",\n      confidence: 0.1,\n      reason: `Record not found in registry. Verified OCR found Roll: ${ocr.roll_number}, but no match in database for this Roll + Semester.`\n    }\n  };\n}\n\nconst db = dbRows[0].json;\nlet score = 0;\nlet checks = [];\n\n// 1. Roll Number Check\nif (ocr.roll_number && db.roll_number && String(ocr.roll_number) === String(db.roll_number)) {\n  score++;\n  checks.push(\"Roll matched\");\n} else {\n  checks.push(`Roll Mismatch: OCR=${ocr.roll_number} vs DB=${db.roll_number}`);\n}\n\n// 2. Hash Check\nif (ocr.certificate_hash === db.certificate_hash) {\n  score++;\n  checks.push(\"Hash verified\");\n} else {\n  checks.push(`HASH TAMPERED: OCR=${ocr.certificate_hash.substring(0,8)}... vs DB=${db.certificate_hash.substring(0,8)}...`);\n}\n\n// 3. Program Check\nif (ocr.program === db.program) {\n  score++;\n  checks.push(\"Program matched\");\n} else {\n  checks.push(`Prog. Mismatch: OCR=${ocr.program} vs DB=${db.program}`);\n}\n\n// 4. Semester Check\nif (ocr.semester === db.semester) {\n  score++;\n  checks.push(\"Semester matched\");\n} else {\n  checks.push(`Sem Mismatch: OCR=${ocr.semester} vs DB=${db.semester}`);\n}\n\nlet status = \"unclear\";\nif (checks.some(c => c.includes(\"Mismatch\") || c.includes(\"TAMPERED\"))) {\n  status = \"fake\";\n} else if (score >= 2) {\n  status = \"verified\";\n}\n\nreturn { json: { status, confidence: score / 4, reason: checks.join(\" | \") } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1500, -64],
      "id": "3aa863e4-d155-4aec-b03a-375035cb8ae0",
      "name": "Compare_OCR_with_DB"
    },
    {
